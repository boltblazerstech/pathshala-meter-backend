# ── Database (Aiven Postgres) ──
DATABASE_URL=jdbc:postgresql://<host>:<port>/<dbname>?sslmode=require
DATABASE_USERNAME=avnadmin
DATABASE_PASSWORD=<password>

# ── JWT ──
# Must be at least 256 bits (32+ chars) for HMAC-SHA256
JWT_SECRET=your-secret-key-here-must-be-at-least-32-characters-long

# ── Server ──
SERVER_PORT=8080
